/* Automatisch aus CMake erzeugt (pico/CMakeLists.txt) - NICHT von Hand aendern und nicht einchecken
 * (enthaelt ggf. Passwoerter). Die Namen entsprechen den CONFIG_KIWI_*-Symbolen des ESP-IDF-Projekts
 * (main/Kconfig.projbuild); das DAC-Audio heisst hier CONFIG_KIWI_AUDIO_*. */
#ifndef KIWI_CONFIG_H
#define KIWI_CONFIG_H

#define CONFIG_KIWI_WIFI_SSID        "@KIWI_WIFI_SSID_C@"
#define CONFIG_KIWI_WIFI_PASSWORD    "@KIWI_WIFI_PASSWORD_C@"
