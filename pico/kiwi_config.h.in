#define CONFIG_KIWI_AUDIO_PREBUFFER_MS @KIWI_AUDIO_PREBUFFER_MS@

#define CONFIG_KIWI_DIR_URL            "@KIWI_DIR_URL_C@"
#define CONFIG_KIWI_DIR_MIN_INTERVAL_S @KIWI_DIR_MIN_INTERVAL_S@
#cmakedefine KIWI_DIR_FAILOVER
#ifdef KIWI_DIR_FAILOVER
#define CONFIG_KIWI_DIR_FAILOVER 1
#endif
#define CONFIG_KIWI_DIR_FAILOVER_MAX   @KIWI_DIR_FAILOVER_MAX@
#define CONFIG_KIWI_DIR_SLOT_KB        @KIWI_DIR_SLOT_KB@

#cmakedefine KIWI_WIFI_NO_POWERSAVE
