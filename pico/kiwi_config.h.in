#define CONFIG_KIWI_PORT             @KIWI_PORT@
#define CONFIG_KIWI_PASSWORD         "@KIWI_PASSWORD_C@"
#define CONFIG_KIWI_USER_NAME        "@KIWI_USER_NAME_C@"
#define CONFIG_KIWI_FREQ_KHZ         "@KIWI_FREQ_KHZ_C@"
#define CONFIG_KIWI_MODE             "@KIWI_MODE_C@"
#cmakedefine KIWI_ADPCM
#ifdef KIWI_ADPCM
#define CONFIG_KIWI_ADPCM 1
#endif
#cmakedefine KIWI_STATUS_LOG
#ifdef KIWI_STATUS_LOG
#define CONFIG_KIWI_STATUS_LOG 1
#endif

#define CONFIG_KIWI_AUDIO_PIN          @KIWI_AUDIO_PIN@
