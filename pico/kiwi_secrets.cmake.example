# Kopieren nach kiwi_secrets.cmake (steht in .gitignore) und anpassen.
# FORCE, damit die Werte auch einen bereits angelegten CMake-Cache ueberschreiben.
set(KIWI_WIFI_SSID     "mein-wlan"      CACHE STRING "" FORCE)
set(KIWI_WIFI_PASSWORD "mein-passwort"  CACHE STRING "" FORCE)
set(KIWI_WIFI_COUNTRY  "DE"             CACHE STRING "" FORCE)
