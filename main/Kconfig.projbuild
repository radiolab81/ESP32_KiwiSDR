menu "KiwiSDR Client"

    config KIWI_WIFI_SSID
        string "WLAN SSID"
        default "meine-ssid"

    config KIWI_WIFI_PASSWORD
        string "WLAN Passwort (leer = offenes WLAN)"
        default ""

    config KIWI_HOST
        string "KiwiSDR Hostname / IPv4"
        default "kiwisdr.adresse.org"

    config KIWI_PORT
        int "KiwiSDR Port"
        default 8073
        range 1 65535

    config KIWI_PASSWORD
        string "KiwiSDR Passwort (leer = oeffentlich)"
        default ""

    config KIWI_USER_NAME
        string "Anzeigename in der Kiwi-Nutzerliste (nur A-Z a-z 0-9 _ -)"
        default "esp32"

    config KIWI_FREQ_KHZ
        string "Startfrequenz in kHz (z. B. 225 oder 7055.5)"
        default "225"

    config KIWI_MODE
        string "Demodulation (am amn amw sam usb lsb cw nbfm ...)"
        default "am"

    config KIWI_ADPCM
        bool "ADPCM-Kompression anfordern (spart WLAN-Bandbreite)"
        default n

    config KIWI_STATUS_LOG
        bool "Status alle 10 s automatisch loggen"
        default n
        help
          Aus (Standard): Die Konsole bleibt beim Tippen ungestoert; den Status
          zeigt der Befehl "s". An: zusaetzlich alle 10 s eine Logzeile mit
          Frames, verlorenen Frames und DAC-Ueber-/Unterlaeufen.

    config KIWI_DAC_GAIN
        int "Software-Verstaerkung vor dem 8-Bit-DAC (1..8)"
        default 2
        range 1 8
        help
          Kiwi-Audio ist AGC-geregelt, aber oft leiser als Vollaussteuerung.
          Zu hohe Werte uebersteuern (Verzerrung).

    config KIWI_DAC_BUFFER_MS
        int "Jitterpuffer in Millisekunden"
        default 1000
        range 200 4000

    config KIWI_DAC_PREBUFFER_MS
        int "Vorpufferung vor Wiedergabestart in Millisekunden"
        default 400
        range 100 2000

    menu "Serververzeichnis (KiwiSDR-Liste)"

        config KIWI_DIR_URL
            string "URL der Serverliste (nur http://)"
            default "http://rx.linkfanel.net/kiwisdr_com.js"
            help
              Maschinenlesbare Liste der oeffentlichen KiwiSDR-Server. Das Update
              laedt sie (ca. 0,9 MB), zerlegt sie waehrend des Empfangs und legt
              eine kompakte Datenbank im Flash ab. Ausgeloest wird es manuell
              mit dem Konsolenbefehl "d update".

        config KIWI_DIR_MIN_INTERVAL_S
            int "Mindestabstand zwischen zwei Updates in Sekunden"
            default 60
            range 0 86400
            help
              Schont den Verzeichnisdienst und den Flash. "d update force"
              umgeht die Sperre.

        config KIWI_DIR_FAILOVER
            bool "Bei nicht erreichbarem Server automatisch zu einem anderen wechseln"
            default y
            help
              Meldet der Kiwi "too busy", "down", falsches Passwort usw. und es kam
              noch kein Audio, wird der naechste passende Server aus der Datenbank
              gewaehlt (Land/Filter aus "d filter" bleiben wirksam, nur Server mit
              freiem Kanal). Ohne Datenbank passiert nichts.

        config KIWI_DIR_FAILOVER_MAX
            int "Maximale Wechsel hintereinander"
            default 5
            range 1 50
            depends on KIWI_DIR_FAILOVER

    endmenu

endmenu
