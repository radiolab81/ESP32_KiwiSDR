# Sinnvolle Voreinstellungen (werden bei "set-target" uebernommen)
CONFIG_IDF_TARGET="esp32"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
# Mehr Netzpuffer = robuster gegen WLAN-Jitter
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=24
CONFIG_LWIP_TCP_WND_DEFAULT=11520
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
# Eigene Partitionstabelle mit Platz fuer die Serverdatenbank (partitions.csv).
# Hinweis: sdkconfig.defaults wirkt nur beim ERSTEN Erzeugen der sdkconfig.
# Bei einem bestehenden Projekt: "idf.py fullclean", sdkconfig loeschen, neu "set-target".
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
